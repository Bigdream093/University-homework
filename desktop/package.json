{
  "name": "university-homework-desktop",
  "version": "1.6.9",
  "description": "墨痕高校作业管理桌面端",
  "author": "墨痕",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "build:teacher": "electron-builder --config electron-builder.teacher.cjs --publish never",
    "build:student": "electron-builder --config electron-builder.student.cjs --publish never",
    "build:student:mac": "electron-builder --config electron-builder.student.cjs --mac --arm64 --publish never && node scripts/prepare-update.cjs student darwin",
    "build": "npm run build:teacher && npm run build:student",
    "prepare:update:teacher": "node scripts/prepare-update.cjs teacher win32",
    "prepare:update:student": "node scripts/prepare-update.cjs student win32",
    "prepare:update:mac": "node scripts/prepare-update.cjs student darwin",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "semver": "7.8.5"
  }
}
